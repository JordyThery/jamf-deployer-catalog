  auto_advance_setup                           = false
  configure_device_before_setup_assistant      = true
  default_prestage                             = false
  device_enrollment_program_instance_id        = data.jamfplatform_pro_automated_device_enrollment.instance.id
  display_name                                 = "${var.name_prefix}PreStage - 1:1"
  do_not_use_profile_from_backup               = false
  enable_device_based_activation_lock          = false
  enforce_temporary_session_timeout            = false
  enforce_user_session_timeout                 = false
  enrollment_customization_id                  = "0"
  enrollment_site_id                           = "-1"
  install_apps_during_enrollment               = false
  keep_existing_location_information           = false
  keep_existing_site_membership                = false
  mandatory                                    = true
  maximum_shared_accounts                      = 10
  mdm_removable                                = false
  multi_user                                   = false
  preserve_managed_apps                        = false
  prestage_minimum_os_target_version_type_ios  = "MINIMUM_OS_LATEST_MINOR_VERSION"
  prestage_minimum_os_target_version_type_ipad = "MINIMUM_OS_LATEST_MINOR_VERSION"
  prevent_activation_lock                      = true
  require_authentication                       = false
  rts_enabled                                  = false
  scope_serial_numbers                         = []
  send_timezone                                = false
  supervised                                   = true
  temporary_session_only                       = false
  temporary_session_timeout                    = 0
  timezone                                     = "UTC"
  use_storage_quota_size                       = false
  user_session_timeout                         = 0
}
